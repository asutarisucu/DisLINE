# ---- 必須はこれだけ ----
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# ---- 以下はすべて任意 ----
# 対象サーバー。未設定なら、Botが参加している唯一のサーバーを自動で使う。
# 複数のサーバーに招待している場合だけ指定する。
# DISCORD_GUILD_ID=

# Botを操作できるDiscordユーザー。未設定ならアプリケーションの所有者（＝あなた）。
# OWNER_ID=

# LINEに申告する端末種別。ログイン後に変えると認証が通らなくなる。
LINE_DEVICE=DESKTOPWIN

# LINEトークを並べるカテゴリ名。50chを超えると LINE-2, LINE-3 と自動で増える。
LINE_CATEGORY_NAME=LINE

# トークン・対応表の保存先（Dockerでは compose 側で /app/data に固定される）
DATA_DIR=./data

# 同時に開いておくチャンネル数の上限。超えると最終活動が古いものから自動で閉じる。
MAX_OPEN_CHANNELS=40

# Discordへ添付するファイルの上限(MB)。Discordの実上限はサーバーのブースト状況で変わる。
# 超えるものは添付せず、種別とサイズだけ表示する。
MAX_UPLOAD_MB=8
